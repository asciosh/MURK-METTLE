{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler", "resolveJsonModule": true,
    "noEmit": true, "strict": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["ui", "vite.config.ts"]
}
