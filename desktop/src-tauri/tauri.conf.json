{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MURK & METTLE",
  "version": "0.1.0",
  "identifier": "dev.asciosh.murkmettle",
  "build": {
    "beforeDevCommand": "npm run launcher:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run launcher:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["launcher"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "publisher": "asciosh",
    "shortDescription": "MURK & METTLE cooperative survival RPG",
    "longDescription": "Windows WebView2 edition of the hosted MURK & METTLE game. Requires an internet connection and the existing Cloudflare account service.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["English"] }
    }
  }
}
