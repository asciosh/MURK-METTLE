{
  "name": "murk-and-mettle",
  "private": true,
  "version": "0.26.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "server": "npm run dev:cloudflare",
    "dev:client": "vite --host 0.0.0.0",
    "deploy": "npm run build && npx wrangler deploy",
    "dev:cloudflare": "npm run build && wrangler dev",
    "test:browser": "node scripts/test-browser.mjs interface characters creature-art combat world mods performance-safety",
    "test:browser:production": "node scripts/test-browser.mjs loading mods-production worker",
    "test:browser:launcher": "node scripts/test-browser.mjs desktop-launcher",
    "test:visual": "node tests/browser/visual-leap.cjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
