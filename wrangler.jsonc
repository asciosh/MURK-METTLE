{
  "name": "murk-mettle",
  "compatibility_date": "2026-11-13",
  "main": "./worker/index.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/room*",
      "/api/profile*",
      "/api/account*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "PLAYER_PROFILES",
        "class_name": "PlayerProfile"
      },
      {
        "name": "PLAYER_ACCOUNTS",
        "class_name": "PlayerAccount"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PlayerProfile"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["PlayerAccount"]
    }
  ]
}
